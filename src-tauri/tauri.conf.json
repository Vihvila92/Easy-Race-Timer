{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Race Timer",
  "version": "0.1.0",
  "identifier": "fi.easyracetimer.app",
  "build": {
    "frontendDist": "shell",
    "beforeDevCommand": "pnpm build:sidecar",
    "beforeBuildCommand": "pnpm build:sidecar"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Easy Race Timer",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "category": "SportsGame",
    "shortDescription": "Race timing for small sports clubs",
    "copyright": "Easy-Race-Timer contributors",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "section": "utils" }
    },
    "externalBin": ["binaries/ert-server"]
  },
  "plugins": {
    "updater": {
      "pubkey": "TODO_REPLACE_WITH_UPDATER_PUBKEY"
    }
  }
}
