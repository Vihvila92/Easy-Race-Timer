# Developer loop only. The installed app does not read this file.
# It binds a free port and stores data in the operating system user directory.
# ERT_DEV_KEY opts in to the public development key. Never set it for a real race.
NODE_ENV=development
ERT_DEV_KEY=1
PORT=8080
ERT_DATA_DIR=./data
# Vite serves the UI on 5173 and proxies /api here. The browser Origin stays on Vite.
ERT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
