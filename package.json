{
  "name": "easy-race-timer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ert/web dev",
    "dev:server": "node --env-file=config/dev.env --import tsx packages/server/src/index.ts",
    "start": "node --import tsx packages/server/src/index.ts",
    "build": "pnpm --filter @ert/web build",
    "build:sidecar": "tsx scripts/build-sidecar.ts",
    "tauri": "tauri",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:spdx": "tsx scripts/check-spdx.ts",
    "e2e": "pnpm build && playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cdxgen": "12.9.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.18.6",
    "dependency-cruiser": "^17.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "fast-check": "^4.2.0",
    "happy-dom": "^21.0.4",
    "node-gyp": "10.3.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11"
  }
}
